generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exhibit {
  id           String        @id @default(cuid())
  /** Exhibit description / theme statement (optional). */
  theme        String        @default("")
  /** Display title; defaults to "Untitled Exhibit #n" when omitted at publish. */
  exhibitTitle String        @default("")
  /** Curator display name; defaults to "Anonymous" when omitted. */
  curatorName  String        @default("")
  /** When true, show on home (recent strip), All exhibits, and sitemap; when false, only the share URL works. */
  featureOnHomepage Boolean  @default(true)
  createdAt    DateTime      @default(now())
  slots        ExhibitSlot[]
}

model ExhibitSlot {
  id         String  @id @default(cuid())
  exhibitId  String
  position   Int
  source     String  @default("met")
  objectId   String
  title      String?
  artist     String?
  imageUrl   String?
  objectUrl  String?
  exhibit    Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([exhibitId, position])
}

/** Eligible artwork IDs for swipe deck sampling (see `npm run art-pool:build`). */
model ArtPoolEntry {
  id        String   @id @default(cuid())
  source    String
  objectId  String
  createdAt DateTime @default(now())

  @@unique([source, objectId])
  @@index([source])
}

/**
 * Frozen copy of the full art pool (same shape as ArtPoolEntry).
 * Populate with `npm run art-pool:archive-full` before capping or experimenting on ArtPoolEntry.
 */
model ArtPoolArchive {
  id        String   @id @default(cuid())
  source    String
  objectId  String
  createdAt DateTime @default(now())

  @@unique([source, objectId])
  @@index([source])
}
