{
  "name": "digital-exhibit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "rm -rf .next node_modules/.cache",
    "build": "prisma generate && next build",
    "prestart": "node scripts/verify-prod-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "art-pools": "node scripts/estimate-art-pools.mjs",
    "art-pool:build": "tsx scripts/build-art-pool.ts",
    "art-pool:build:whitney": "tsx scripts/build-art-pool.ts --only whitney",
    "art-pool:build:rijks": "tsx scripts/build-art-pool.ts --only rijks",
    "art-pool:build:ngl": "tsx scripts/build-art-pool.ts --only ngl",
    "art-pool:build:getty": "tsx scripts/build-art-pool.ts --only getty",
    "art-pool:topup:getty": "tsx scripts/build-art-pool.ts --only getty --append",
    "art-pool:build:met": "tsx scripts/build-art-pool.ts --only met",
    "art-pool:topup:met": "tsx scripts/build-art-pool.ts --only met --append",
    "art-pool:topup:ngl": "tsx scripts/build-art-pool.ts --only ngl --append",
    "art-pool:build:vam": "tsx scripts/build-art-pool.ts --only vam",
    "art-pool:topup:vam": "tsx scripts/build-art-pool.ts --only vam --append",
    "art-pool:build:mplus": "tsx scripts/build-art-pool.ts --only mplus",
    "art-pool:topup:mplus": "tsx scripts/build-art-pool.ts --only mplus --append",
    "art-pool:build:nma": "tsx scripts/build-art-pool.ts --only nma",
    "art-pool:topup:nma": "tsx scripts/build-art-pool.ts --only nma --append",
    "art-pool:build:cooper": "tsx scripts/build-art-pool.ts --only cooper",
    "art-pool:topup:cooper": "tsx scripts/build-art-pool.ts --only cooper --append",
    "art-pool:archive-full": "tsx scripts/art-pool-archive-full.ts",
    "art-pool:restore-from-archive": "tsx scripts/art-pool-restore-from-archive.ts",
    "art-pool:cap": "tsx scripts/art-pool-cap.ts",
    "art-pool:clone-to-backup-db": "tsx scripts/art-pool-clone-to-backup-db.ts",
    "benchmark:art-fetch": "tsx scripts/benchmark-art-fetch.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.6",
    "prisma": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
