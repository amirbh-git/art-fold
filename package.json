{
  "name": "digital-exhibit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "rm -rf .next node_modules/.cache",
    "build": "prisma generate && next build",
    "prestart": "node scripts/verify-prod-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "art-pools": "node scripts/estimate-art-pools.mjs",
    "art-pool:build": "tsx scripts/build-art-pool.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "prisma": "^6.3.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
