{
  "name": "art-fold",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:fresh": "npm run clean && next dev -p 3000",
    "clean": "rm -rf .next node_modules/.cache",
    "build": "prisma generate && tsx scripts/build-sitemap.ts && next build",
    "build-sitemap": "tsx scripts/build-sitemap.ts",
    "prestart": "node scripts/verify-prod-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "art-pools": "node scripts/estimate-art-pools.mjs",
    "art-pool:build": "tsx scripts/build-art-pool.ts",
    "art-pool:build:whitney": "tsx scripts/build-art-pool.ts --only whitney",
    "art-pool:build:rijks": "tsx scripts/build-art-pool.ts --only rijks",
    "art-pool:build:ngl": "tsx scripts/build-art-pool.ts --only ngl",
    "art-pool:build:getty": "tsx scripts/build-art-pool.ts --only getty",
    "art-pool:topup:getty": "tsx scripts/build-art-pool.ts --only getty --append",
    "art-pool:build:met": "tsx scripts/build-art-pool.ts --only met",
    "art-pool:enrich:met": "tsx scripts/build-art-pool.ts --only met --met-enrich-only",
    "art-pool:build:met:test": "MET_POOL_QUICK_SEARCH=1 MET_POOL_TEST_FRACTION=0.01 MET_POOL_PROGRESS_EVERY_BATCHES=2 tsx scripts/build-art-pool.ts --only met --append",
    "art-pool:topup:met": "tsx scripts/build-art-pool.ts --only met --append",
    "art-pool:topup:ngl": "tsx scripts/build-art-pool.ts --only ngl --append",
    "art-pool:build:vam": "tsx scripts/build-art-pool.ts --only vam",
    "art-pool:topup:vam": "tsx scripts/build-art-pool.ts --only vam --append",
    "art-pool:build:mplus": "tsx scripts/build-art-pool.ts --only mplus",
    "art-pool:topup:mplus": "tsx scripts/build-art-pool.ts --only mplus --append",
    "art-pool:build:nma": "tsx scripts/build-art-pool.ts --only nma",
    "art-pool:topup:nma": "tsx scripts/build-art-pool.ts --only nma --append",
    "art-pool:build:cooper": "tsx scripts/build-art-pool.ts --only cooper",
    "art-pool:topup:cooper": "tsx scripts/build-art-pool.ts --only cooper --append",
    "art-pool:enrich-metadata": "tsx scripts/enrich-art-pool-metadata.ts",
    "art-pool:archive-full": "tsx scripts/art-pool-archive-full.ts",
    "art-pool:restore-from-archive": "tsx scripts/art-pool-restore-from-archive.ts",
    "art-pool:cap": "tsx scripts/art-pool-cap.ts",
    "art-pool:cap-artist-share": "tsx scripts/art-pool-cap-artist-share.ts",
    "art-pool:cap-harvard": "tsx scripts/art-pool-cap-artist-share.ts --source harvard --max-frac 0.01",
    "art-pool:cap-vam-frith": "tsx scripts/art-pool-cap-artist-share.ts --source vam --artist-exact-name \"Francis Frith\" --artist-max-rows 130",
    "art-pool:cap-popular-1k": "tsx scripts/art-pool-cap-artist-share.ts --source popular --cap-rows-per-artist 1000",
    "art-pool:cap-popular-500": "tsx scripts/art-pool-cap-artist-share.ts --source popular --cap-rows-per-artist 500",
    "art-pool:clone-to-backup-db": "tsx scripts/art-pool-clone-to-backup-db.ts",
    "art-pool:export-csv": "tsx scripts/art-pool-export-csv.ts",
    "art-pool:import-csv": "tsx scripts/art-pool-import-from-csv.ts",
    "benchmark:art-fetch": "tsx scripts/benchmark-art-fetch.ts",
    "art-pool:popular-counts": "tsx scripts/count-popular-pool-by-artist.ts --source popular",
    "art-pool:artist-counts": "tsx scripts/count-popular-pool-by-artist.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.6",
    "prisma": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
