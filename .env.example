# PostgreSQL connection string (Neon, Supabase, Railway, local Docker, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_exhibit?schema=public"

# Optional: public site URL for Open Graph canonical links (e.g. https://your-domain.com)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: include Harvard Art Museums in the random card mix (https://harvardartmuseums.org/collections/api)
# HARVARD_ART_API_KEY=""

# Optional: National Museum of Australia Collection API — higher rate limits (https://github.com/NationalMuseumAustralia/Collection-API/wiki)
# NMA_API_KEY=""

# Optional: M+ Museum GraphQL — bearer for higher limits (either name works)
# MPLUS_API_KEY=""
# MPLUS_GRAPHQL_BEARER=""
# MPLUS_POOL_MAX_PAGES=""
# MPLUS_POOL_KEYWORD_MAX_PAGES=""

# Optional: Cooper Hewitt pool crawl tuning
# COOPER_POOL_PAGE_DELAY_MS=""
# COOPER_POOL_MAX_PAGES=""

# Optional: Getty pool tuning
# GETTY_POOL_MAX_PAGES=""
# GETTY_POOL_ARTIST_CHUNK=""

# Optional: National Gallery London — set to "0" to disable keyword supplement
# NGL_POOL_KEYWORD_SUPPLEMENT=""

# Optional: Rijksmuseum pool concurrency / delay
# RIJKS_POOL_ARTIST_CONCURRENCY=""
# RIJKS_POOL_ARTIST_DELAY_MS=""

# Optional: Met collection API — User-Agent / language and pool build tuning (see lib/art-sources/met.ts, scripts/build-art-pool.ts)
# MET_HTTP_USER_AGENT=""
# MET_HTTP_ACCEPT_LANGUAGE=""
# MET_POOL_OBJECT_FETCH_ATTEMPTS=""
# MET_POOL_PROGRESS_EVERY_BATCHES=""
# MET_POOL_QUICK_SEARCH=""
# MET_POOL_TEST_FRACTION=""
# MET_POOL_MAX_IDS=""
# MET_POOL_ARTIST_CONCURRENCY=""
# MET_POOL_ARTIST_DELAY_MS=""
# MET_POOL_SAVE_ID_LIST=""
# MET_POOL_IDS_FILE=""
# MET_POOL_ENRICH_ONLY=""
# MET_POOL_ENRICH_MISSING=""

# Art pool maintenance (see package.json art-pool:archive-full, art-pool:cap, art-pool:clone-to-backup-db)
# ART_POOL_CAP_MAX="25000"
# ART_POOL_BACKUP_DATABASE_URL="postgresql://...second-db..."

# Optional: npm run benchmark:art-fetch — BENCHMARK_REPEATS BENCHMARK_GAP_MS BENCHMARK_WARMUP
