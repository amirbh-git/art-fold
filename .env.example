# PostgreSQL connection string (Neon, Supabase, Railway, local Docker, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_exhibit?schema=public"

# Optional: public site URL for Open Graph canonical links (e.g. https://your-domain.com)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: include Harvard Art Museums in the random card mix (https://harvardartmuseums.org/collections/api)
# HARVARD_ART_API_KEY=""

# Optional: National Museum of Australia Collection API — higher rate limits (https://github.com/NationalMuseumAustralia/Collection-API/wiki)
# NMA_API_KEY=""

# Art pool maintenance (see package.json art-pool:archive-full, art-pool:cap, art-pool:clone-to-backup-db)
# ART_POOL_CAP_MAX="25000"
# ART_POOL_BACKUP_DATABASE_URL="postgresql://...second-db..."

# Optional: npm run benchmark:art-fetch — BENCHMARK_REPEATS BENCHMARK_GAP_MS BENCHMARK_WARMUP
